{
  "name": "cf-void-starter",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "playwright test",
    "deploy": "pnpm --filter @cf-void-starter/web deploy",
    "db:generate": "pnpm --filter @cf-void-starter/web db:generate",
    "db:migrate": "pnpm --filter @cf-void-starter/web db:migrate",
    "db:seed": "pnpm --filter @cf-void-starter/web db:seed",
    "cf": "pnpm --filter @cf-void-starter/web exec cf",
    "prepare": "sh scripts/install-git-hooks.sh"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "lefthook": "2.2.2",
    "oxfmt": "0.80.0",
    "oxlint": "1.95.0",
    "turbo": "^2.11.13"
  },
  "engines": {
    "node": ">=24.22.0"
  },
  "packageManager": "pnpm@12.23.0"
}
